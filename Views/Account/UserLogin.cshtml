@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>User Gateway - FilmFusion</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
        background: linear-gradient(rgba(15, 23, 42, 0.85), rgba(2, 6, 23, 0.9)), url('https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?q=80&w=1920&auto=format&fit=crop');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center p-4">

    <div class="max-w-md w-full bg-slate-900/40 backdrop-blur-xl border border-indigo-500/20 rounded-3xl p-8 shadow-2xl space-y-6">
        <div class="text-center">
            <div class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-indigo-600/20 text-indigo-400 mb-3 border border-indigo-500/30">
                <i class="fa-solid fa-user text-xl"></i>
            </div>
            <h2 class="text-2xl font-black uppercase tracking-wider text-white">User Gateway</h2>
            <p class="text-xs text-slate-400 mt-1">Enter your registered identifiers to proceed.</p>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="p-3 bg-rose-500/10 border border-rose-500/30 text-rose-400 text-xs rounded-xl text-center">
                <i class="fa-solid fa-circle-exclamation mr-1"></i> @TempData["ErrorMessage"]
            </div>
        }

        <form asp-controller="Account" asp-action="UserLogin" method="post" autocomplete="off" class="space-y-4">
            @Html.AntiForgeryToken()
            <div>
                <label class="text-[10px] text-indigo-400 font-bold uppercase tracking-wider block mb-2">Email Address</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-slate-500"><i class="fa-solid fa-envelope text-xs"></i></span>
                    <input type="email" name="email" required placeholder="name@domain.com" class="w-full bg-slate-950/80 border border-slate-800 rounded-xl pl-10 pr-4 py-3.5 text-xs text-white focus:outline-none focus:border-indigo-500 transition-colors" />
                </div>
            </div>
            <div>
                <label class="text-[10px] text-indigo-400 font-bold uppercase tracking-wider block mb-2">Password</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-slate-500"><i class="fa-solid fa-lock text-xs"></i></span>
                    <input type="password" name="password" required placeholder="••••••••" class="w-full bg-slate-950/80 border border-slate-800 rounded-xl pl-10 pr-4 py-3.5 text-xs text-white focus:outline-none focus:border-indigo-500 transition-colors" />
                </div>
            </div>
            <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs py-3.5 rounded-xl transition-all shadow-lg uppercase tracking-wider mt-2">Sign In As User</button>
            
            <div class="text-center mt-2">
                <a href="/Account/Register" class="text-[11px] text-slate-400 hover:text-indigo-400 transition-colors">Need an account? Register Here</a>
            </div>
        </form>
    </div>

</body>
</html>