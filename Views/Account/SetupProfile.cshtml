@{
    Layout = "_AuthLayout";
}

<div class="max-w-xl w-full bg-slate-900/40 backdrop-blur-xl border border-slate-800/60 rounded-3xl p-8 shadow-2xl space-y-6">
    <div>
        <h2 class="text-xl font-black uppercase tracking-wider text-emerald-400"><i class="fa-solid fa-sliders mr-1"></i> Personalization Matrix</h2>
        <p class="text-xs text-slate-400 mt-1">Step 2 of 2: Tailoring your AI Recommendation Engine</p>
    </div>

    <form asp-action="SetupProfile" method="post" class="space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="text-[10px] text-emerald-400 font-bold uppercase tracking-wider block mb-1">Full Legal Name</label>
                <input type="text" name="fullName" required placeholder="Irsa Razzaq" class="w-full bg-slate-950/80 border border-slate-800 rounded-xl px-4 py-2.5 text-xs text-white focus:outline-none focus:border-emerald-500" />
            </div>
            <div>
                <label class="text-[10px] text-emerald-400 font-bold uppercase tracking-wider block mb-1">Your Age Parameter</label>
                <input type="number" name="age" required min="10" max="100" placeholder="21" class="w-full bg-slate-950/80 border border-slate-800 rounded-xl px-4 py-2.5 text-xs text-white focus:outline-none focus:border-emerald-500" />
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="text-[10px] text-emerald-400 font-bold uppercase tracking-wider block mb-1">Primary Genre Vector</label>
                <select name="preferredGenre" class="w-full bg-slate-950/80 border border-slate-800 rounded-xl px-3 py-2.5 text-xs text-slate-300 focus:outline-none focus:border-emerald-500">
                    <option value="Sci-Fi & Cyberpunk">Sci-Fi & Cyberpunk</option>
                    <option value="Psychological Thriller">Psychological Thriller</option>
                    <option value="Action & Suspense">Action & Suspense</option>
                    <option value="Romance & Drama">Romance & Drama</option>
                </select>
            </div>
            <div>
                <label class="text-[10px] text-emerald-400 font-bold uppercase tracking-wider block mb-1">Language Track Preference</label>
                <select name="languagePreference" class="w-full bg-slate-950/80 border border-slate-800 rounded-xl px-3 py-2.5 text-xs text-slate-300 focus:outline-none focus:border-emerald-500">
                    <option value="English (With Subtitles)">English (With Subtitles)</option>
                    <option value="Hindi / Urdu Core">Hindi / Urdu Core</option>
                    <option value="Korean / K-Drama">Korean / K-Drama</option>
                </select>
            </div>
        </div>

        <div>
            <label class="text-[10px] text-emerald-400 font-bold uppercase tracking-wider block mb-1">How often do you watch movies?</label>
            <div class="grid grid-cols-3 gap-2 mt-1">
                <label class="bg-slate-950/80 border border-slate-800 rounded-xl p-3 text-center cursor-pointer block hover:border-emerald-500/50">
                    <input type="radio" name="watchFrequency" value="Daily" checked class="accent-emerald-500 block mx-auto mb-1" />
                    <span class="text-[10px] text-slate-400 block">Daily</span>
                </label>
                <label class="bg-slate-950/80 border border-slate-800 rounded-xl p-3 text-center cursor-pointer block hover:border-emerald-500/50">
                    <input type="radio" name="watchFrequency" value="Weekends" class="accent-emerald-500 block mx-auto mb-1" />
                    <span class="text-[10px] text-slate-400 block">Weekends</span>
                </label>
                <label class="bg-slate-950/80 border border-slate-800 rounded-xl p-3 text-center cursor-pointer block hover:border-emerald-500/50">
                    <input type="radio" name="watchFrequency" value="Rarely" class="accent-emerald-500 block mx-auto mb-1" />
                    <span class="text-[10px] text-slate-400 block">Rarely</span>
                </label>
            </div>
        </div>

        <div>
            <label class="text-[10px] text-emerald-400 font-bold uppercase tracking-wider block mb-1">Describe specific tags or themes you follow</label>
            <textarea name="systemInterests" rows="3" required placeholder="e.g., Christopher Nolan movies, time travel mechanics, dark psychological tropes..." class="w-full bg-slate-950/80 border border-slate-800 rounded-xl px-4 py-2.5 text-xs text-white focus:outline-none focus:border-emerald-500 resize-none"></textarea>
        </div>

        <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs py-3 rounded-xl transition-all shadow-lg shadow-emerald-600/20 cursor-pointer">
            <i class="fa-solid fa-paper-plane mr-1"></i> Save Parameters & Deploy Profile
        </button>
    </form>
</div>