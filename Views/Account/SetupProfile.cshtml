@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-900">
<head>
    <meta charset="utf-8" />
    <title>Profile Survey Calibration</title>
    <script src="https://unpkg.com/@@tailwindcss/browser@@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body class="h-full bg-gradient-to-b from-slate-900 to-slate-800 flex items-center justify-center p-4 text-slate-200">

    <div class="max-w-md w-full bg-slate-800 border border-slate-700/70 rounded-2xl p-6 shadow-xl">
        <div class="mb-5 text-center">
            <h2 class="text-xl font-bold text-white">Preference Calibration</h2>
            <p class="text-xs text-slate-400 mt-0.5">Specify baseline configuration metrics to structure the streaming module logs.</p>
        </div>

        <form asp-action="SaveOnboardingData" method="post" class="space-y-4">
            
            <div>
                <label class="text-xs font-semibold text-slate-300 block mb-1.5">Age Matrix Profile: <span id="ageDisplay" class="text-indigo-400 font-bold ml-0.5">18</span> Years</label>
                <input type="range" name="age" min="6" max="90" value="18" class="w-full accent-indigo-500 bg-slate-900 h-1.5 rounded-lg cursor-pointer" oninput="document.getElementById('ageDisplay').innerText = this.value" />
            </div>

            <div>
                <label class="text-xs font-semibold text-slate-300 block mb-1">Gender Identification</label>
                <select name="gender" class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-xl text-xs text-slate-200 focus:outline-none focus:border-indigo-500">
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                    <option value="Other">Non-Binary / Undisclosed</option>
                </select>
            </div>

            <div>
                <label class="text-xs font-semibold text-slate-300 block mb-1">Preferred Genres (Comma Separated)</label>
                <input type="text" name="preferredGenres" required class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-xl text-xs text-white focus:outline-none focus:border-indigo-500" placeholder="Action, Sci-Fi, Thriller..." />
            </div>

            <div>
                <label class="text-xs font-semibold text-slate-300 block mb-1">Streaming Sync Frequency</label>
                <select name="watchFrequency" class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-xl text-xs text-slate-200 focus:outline-none focus:border-indigo-500">
                    <option value="Daily">Daily standard tracking logs</option>
                    <option value="Weekends">Weekend active interval sessions</option>
                    <option value="Rarely">Intermittent evaluation cycles</option>
                </select>
            </div>

            <button type="submit" class="w-full py-2.5 bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-600 hover:to-purple-700 text-white font-semibold rounded-xl text-xs transition-all shadow-md mt-2 cursor-pointer">
                Save Tracking Configurations
            </button>
        </form>
    </div>

</body>
</html>