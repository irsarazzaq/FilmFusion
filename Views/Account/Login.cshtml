@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In - FilmFusion Core Platform</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
        background: linear-gradient(rgba(2, 6, 23, 0.85), rgba(15, 23, 42, 0.95)), url('https://images.unsplash.com/photo-1536440136628-849c177e76a1?q=80&w=1925&auto=format&fit=crop');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center p-4">
    <div class="max-w-md w-full bg-slate-900/40 backdrop-blur-xl border border-slate-800/60 rounded-3xl p-8 shadow-2xl space-y-6">
        <div class="text-center">
            <div class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-indigo-600/20 text-indigo-400 mb-3 border border-indigo-500/30">
                <i class="fa-solid fa-shield-halved text-xl"></i>
            </div>
            <h2 class="text-2xl font-black uppercase tracking-wider text-white">Authentication Gate</h2>
            <p class="text-xs text-slate-400 mt-1">Provide secure keys to connect with database cluster layer.</p>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="p-3 bg-rose-500/10 border border-rose-500/30 text-rose-400 text-xs rounded-xl flex items-center gap-2">
                <i class="fa-solid fa-circle-exclamation"></i> @TempData["ErrorMessage"]
            </div>
        }
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="p-3 bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs rounded-xl flex items-center gap-2">
                <i class="fa-solid fa-envelope-circle-check"></i> @TempData["SuccessMessage"]
            </div>
        }

        <form asp-action="Login" method="post" class="space-y-4">
            <div>
                <label class="text-[10px] text-indigo-400 font-bold uppercase tracking-wider block mb-1">Username / Email Address</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-500"><i class="fa-solid fa-user-shield text-xs"></i></span>
                    <input type="text" name="email" required placeholder="admin or member email address" class="w-full bg-slate-950/80 border border-slate-800 rounded-xl pl-9 pr-4 py-3 text-xs text-white focus:outline-none focus:border-indigo-500 transition-colors" />
                </div>
            </div>
            <div>
                <label class="text-[10px] text-indigo-400 font-bold uppercase tracking-wider block mb-1">Account Password Token</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-500"><i class="fa-solid fa-lock text-xs"></i></span>
                    <input type="password" name="password" required placeholder="••••••••" class="w-full bg-slate-950/80 border border-slate-800 rounded-xl pl-9 pr-4 py-3 text-xs text-white focus:outline-none focus:border-indigo-500 transition-colors" />
                </div>
            </div>
            <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs py-3 rounded-xl transition-all shadow-lg shadow-indigo-600/20 cursor-pointer uppercase tracking-wider">
                Verify Identity Structure
            </button>
        </form>

        <div class="text-center border-t border-slate-800/60 pt-4">
            <a asp-action="Register" class="text-xs text-slate-400 hover:text-indigo-400 transition-colors">Need a profile node? <span class="text-indigo-400 font-bold underline">Register Profile</span></a>
        </div>
    </div>
</body>
</html>