@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-900">
<head>
    <meta charset="utf-8" />
    <title>Sign In - FilmFusion</title>
    <script src="https://unpkg.com/@@tailwindcss/browser@@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        .login-split-bg {
        background-image: linear-gradient(to right, rgba(15, 23, 42, 0.95) 40%, rgba(15, 23, 42, 0.4)), url('https://images.unsplash.com/photo-1478720568477-151d9b14726b?q=80&w=1920&auto=format&fit=crop');
        background-size: cover;
        background-position: center;
        }
    </style>
</head>
<body class="h-full login-split-bg flex items-center justify-start p-6 sm:p-12 md:p-24 text-slate-200">

    <div class="w-full max-w-sm bg-slate-800/90 border border-slate-700/60 rounded-2xl p-6 shadow-2xl backdrop-blur-md">
        <div class="mb-5">
            <h1 class="text-2xl font-bold tracking-tight text-white">Authentication Gate</h1>
            <p class="text-xs text-slate-400 mt-0.5">Provide secure keys to connect with your database module.</p>
        </div>

        <form asp-action="Login" method="post" autocomplete="off" class="space-y-4">
            
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="ModelOnly" class="text-xs text-rose-400 bg-rose-500/10 p-2 rounded-lg"></div>
            }

            <div>
                <label class="text-xs font-semibold text-slate-300 block mb-1">Username / Email Address</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400"><i class="fa-regular fa-user text-xs"></i></span>
                    <input type="text" name="username" required autocomplete="new-password" class="w-full pl-9 pr-3 py-2 bg-slate-900 border border-slate-700 rounded-xl text-white text-xs focus:outline-none focus:border-indigo-500" placeholder="admin or member email" />
                </div>
            </div>

            <div>
                <label class="text-xs font-semibold text-slate-300 block mb-1">Account Password</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400"><i class="fa-solid fa-lock text-xs"></i></span>
                    <input type="password" name="password" required autocomplete="new-password" class="w-full pl-9 pr-3 py-2 bg-slate-900 border border-slate-700 rounded-xl text-white text-xs focus:outline-none focus:border-indigo-500" placeholder="••••••••" />
                </div>
            </div>

            <button type="submit" class="w-full py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl text-xs transition-all shadow-md mt-1 cursor-pointer">
                Verify Identity
            </button>
        </form>

        <div class="mt-4 text-center border-t border-slate-700/50 pt-3.5">
            <p class="text-xs text-slate-400">Need a profile node? <a asp-action="Register" class="text-indigo-400 hover:text-indigo-300 font-bold">Register Profile</a></p>
        </div>
    </div>
</body>
</html>