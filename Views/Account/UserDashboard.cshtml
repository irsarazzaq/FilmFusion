@model IEnumerable<FilmFusion.Models.Movie>

@{
    Layout = null;

    var userName = Context.Session.GetString("UserName") ?? "User";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>FilmFusion Dashboard</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>

        body {
        background: #020617;
        font-family: monospace;
        overflow-x: hidden;
        }

        ::-webkit-scrollbar {
        width: 6px;
        }

        ::-webkit-scrollbar-thumb {
        background: #7c3aed;
        border-radius: 50px;
        }

        .tab-active {
        border-color: #a855f7;
        color: #a855f7;
        font-weight: bold;
        }

        .custom-scroll {
        scrollbar-width: thin;
        }

        .movie-card {
        transition: 0.3s ease;
        }

        .movie-card:hover {
        transform: translateY(-5px);
        }

        .comment-box::-webkit-scrollbar {
        width: 4px;
        }

        .comment-box::-webkit-scrollbar-thumb {
        background: #9333ea;
        }

    </style>
</head>

<body class="min-h-screen text-white flex flex-col">

    <!-- TOAST -->

    <div id="toast-container"
         class="fixed top-5 right-5 z-[999] flex flex-col gap-3">
    </div>

    <!-- HEADER -->

    <header class="sticky top-0 z-50 bg-slate-950/95 backdrop-blur-xl border-b border-slate-800">

        <div class="px-6 py-4 flex items-center justify-between">

            <div class="flex items-center gap-4">

                <div class="w-12 h-12 rounded-2xl bg-purple-600/20 border border-purple-500/30 flex items-center justify-center">
                    <i class="fa-solid fa-clapperboard text-purple-400 text-lg"></i>
                </div>

                <div>
                    <h1 class="text-sm font-black uppercase tracking-[0.3em]">
                        FilmFusion
                    </h1>

                    <p class="text-[10px] text-slate-500 uppercase tracking-[0.25em]">
                        AI Movie Dashboard
                    </p>
                </div>

            </div>

            <!-- RIGHT SIDE -->

            <div class="flex items-center gap-4">

                <!-- NOTIFICATION -->

                <button onclick="toggleNotifications()"
                        class="relative bg-slate-900 border border-slate-800 hover:border-purple-500/40 w-12 h-12 rounded-xl flex items-center justify-center transition-all">

                    <i class="fa-solid fa-bell text-purple-400"></i>

                    <span id="noti-count"
                          class="absolute -top-1 -right-1 bg-rose-500 text-white text-[10px] w-5 h-5 rounded-full flex items-center justify-center">
                        3
                    </span>

                </button>

                <!-- PROFILE -->

                <button onclick="openProfileModal()"
                        class="flex items-center gap-3 bg-slate-900 border border-slate-800 hover:border-purple-500/40 rounded-xl px-3 py-2 transition-all">

                    <img id="profile-preview"
                         src="https://ui-avatars.com/api/?name=@userName&background=7c3aed&color=fff"
                         class="w-11 h-11 rounded-full object-cover border border-purple-500/30" />

                    <div class="flex flex-col items-start">

                        <span class="text-[10px] uppercase tracking-widest text-slate-500">
                            User Node
                        </span>

                        <span id="username-display"
                              class="text-xs font-bold uppercase">
                            @userName
                        </span>

                    </div>

                </button>

                <!-- LOGOUT -->

                <a href="@Url.Action("Logout", "Account")"
                   class="bg-rose-500/10 border border-rose-500/30 hover:bg-rose-500/20 text-rose-400 px-4 py-3 rounded-xl text-xs uppercase tracking-widest font-bold transition-all">

                    <i class="fa-solid fa-power-off mr-1"></i>
                    Logout

                </a>

            </div>

        </div>

    </header>

    <!-- NOTIFICATION PANEL -->

    <div id="notification-panel"
         class="hidden fixed top-24 right-5 z-[200] w-80 bg-slate-950 border border-slate-800 rounded-3xl overflow-hidden shadow-2xl">

        <div class="p-5 border-b border-slate-800 flex items-center justify-between">

            <h2 class="text-sm uppercase tracking-widest font-bold text-purple-400">
                Notifications
            </h2>

            <button onclick="toggleNotifications()">
                <i class="fa-solid fa-xmark text-slate-400 hover:text-rose-400"></i>
            </button>

        </div>

        <div class="max-h-96 overflow-y-auto custom-scroll">

            <div class="p-4 border-b border-slate-800 text-xs text-slate-300">
                🎬 New movie added to collection.
            </div>

            <div class="p-4 border-b border-slate-800 text-xs text-slate-300">
                ⭐ Your rating was saved successfully.
            </div>

            <div class="p-4 text-xs text-slate-300">
                ❤️ Added movie to favorites.
            </div>

        </div>

    </div>

    <!-- MAIN -->

    <main class="max-w-7xl w-full mx-auto p-6 space-y-8">

        <!-- HERO -->

        <section class="relative rounded-3xl overflow-hidden border border-slate-800 shadow-2xl">

            <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/70 to-transparent z-10"></div>

            <iframe class="w-full aspect-[21/8]"
                    src="https://www.youtube.com/embed/w7pYhpJaJW8?autoplay=1&mute=1&controls=0&loop=1&playlist=w7pYhpJaJW8"
                    allowfullscreen>
            </iframe>

            <div class="absolute inset-0 z-20 flex flex-col justify-center px-10 max-w-2xl">

                <span class="text-purple-400 uppercase tracking-[0.3em] text-xs font-bold mb-4">
                    Featured Stream
                </span>

                <h1 class="text-6xl font-black">
                    ALITA:BATTLE ANGEL
                </h1>

                <p class="mt-5 text-sm text-slate-300 leading-relaxed">
                    An abandoned cyborg navigates a treacherous cyberpunk city to discover her true destiny as a legendary warrior.
                </p>

            </div>

        </section>

        <!-- TABS -->

        <div class="flex flex-wrap gap-4 border-b border-slate-800 pb-3">

            <button onclick="switchTab('all',this)"
                    class="tab-btn tab-active px-4 py-2 text-xs uppercase tracking-widest border-b-2 border-transparent">
                All Movies
            </button>

            <button onclick="switchTab('favorites',this)"
                    class="tab-btn px-4 py-2 text-xs uppercase tracking-widest border-b-2 border-transparent">
                Favorites
            </button>

            <button onclick="switchTab('watchlater',this)"
                    class="tab-btn px-4 py-2 text-xs uppercase tracking-widest border-b-2 border-transparent">
                Watch Later
            </button>

            <button onclick="switchTab('downloads',this)"
                    class="tab-btn px-4 py-2 text-xs uppercase tracking-widest border-b-2 border-transparent">
                Downloads
            </button>

        </div>

        <!-- MOVIES -->

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">

            @foreach (var movie in Model)
            {
                <div class="movie-card bg-slate-950 border border-slate-800 rounded-3xl overflow-hidden flex flex-col"
                     data-title="@movie.Title">

                    <div class="relative aspect-[16/10] overflow-hidden">

                        <img src="@movie.PosterUrl"
                             class="w-full h-full object-cover hover:scale-105 transition-all duration-500" />

                        <div class="absolute inset-0 bg-gradient-to-t from-black to-transparent"></div>

                        <button onclick="playMovieInline('@movie.Title')"
                                class="absolute inset-0 flex items-center justify-center">

                            <div class="w-16 h-16 rounded-full bg-purple-600 hover:bg-purple-500 flex items-center justify-center shadow-2xl">
                                <i class="fa-solid fa-play text-white text-lg"></i>
                            </div>

                        </button>

                    </div>

                    <div class="p-5 flex flex-col gap-4 flex-1">

                        <div>

                            <h2 class="text-sm font-bold uppercase tracking-wider">
                                @movie.Title
                            </h2>

                            <p class="text-xs text-slate-500 mt-2 line-clamp-3">
                                @movie.Description
                            </p>

                        </div>

                        <div class="flex items-center justify-between mt-auto">

                            <div class="flex gap-4 text-sm">

                                <button onclick="savePermanent('@movie.Title','favorites')"
                                        class="hover:text-rose-400 transition-all">
                                    <i class="fa-solid fa-heart"></i>
                                </button>

                                <button onclick="savePermanent('@movie.Title','watchlater')"
                                        class="hover:text-sky-400 transition-all">
                                    <i class="fa-solid fa-clock"></i>
                                </button>

                                <button onclick="savePermanent('@movie.Title','downloads')"
                                        class="hover:text-emerald-400 transition-all">
                                    <i class="fa-solid fa-download"></i>
                                </button>

                            </div>

                            <div class="flex gap-1 text-amber-400 text-xs">

                                <i class="fa-solid fa-star"></i>
                                <i class="fa-solid fa-star"></i>
                                <i class="fa-solid fa-star"></i>
                                <i class="fa-solid fa-star"></i>
                                <i class="fa-solid fa-star-half-stroke"></i>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>

    </main>

    <!-- VIDEO MODAL -->

    <div id="video-modal"
         class="fixed inset-0 bg-black/90 hidden items-center justify-center z-[300] p-4 overflow-y-auto">

        <div class="w-full max-w-7xl bg-slate-950 rounded-3xl border border-slate-800 overflow-hidden">

            <!-- TOP -->

            <div class="sticky top-0 z-20 bg-slate-950 border-b border-slate-800 px-6 py-4 flex items-center justify-between">

                <h2 id="modal-title"
                    class="text-sm uppercase tracking-widest font-bold text-purple-400">
                    Streaming
                </h2>

                <button onclick="closeMovieModal()"
                        class="w-10 h-10 rounded-full bg-rose-500/10 hover:bg-rose-500/20 flex items-center justify-center">

                    <i class="fa-solid fa-xmark text-rose-400"></i>

                </button>

            </div>

            <!-- CONTENT -->

            <div class="grid lg:grid-cols-3">

                <!-- VIDEO -->

                <div class="lg:col-span-2">

                    <div class="aspect-video">

                        <iframe id="movie-frame"
                                class="w-full h-full"
                                allowfullscreen>
                        </iframe>

                    </div>

                </div>

                <!-- COMMENTS -->

                <div class="border-l border-slate-800 flex flex-col h-[75vh]">

                    <div class="p-4 border-b border-slate-800">

                        <h3 class="text-sm uppercase tracking-widest font-bold text-purple-400">
                            Live Comments
                        </h3>

                    </div>

                    <div id="comments-container"
                         class="flex-1 overflow-y-auto p-4 space-y-3 comment-box">
                    </div>

                    <div class="p-4 border-t border-slate-800 flex gap-3">

                        <input type="text"
                               id="comment-input"
                               placeholder="Write comment..."
                               class="flex-1 bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-sm outline-none focus:border-purple-500" />

                        <button onclick="submitComment()"
                                class="bg-purple-600 hover:bg-purple-500 px-5 rounded-xl text-sm font-bold uppercase">

                            Send

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- PROFILE MODAL -->

    <div id="profile-modal"
         class="fixed inset-0 bg-black/90 hidden items-center justify-center z-[400] p-4 overflow-y-auto">

        <div class="w-full max-w-xl bg-slate-950 border border-slate-800 rounded-3xl overflow-hidden">

            <div class="sticky top-0 bg-slate-950 z-20 border-b border-slate-800 px-6 py-5 flex items-center justify-between">

                <div>
                    <h2 class="text-2xl font-black uppercase">
                        User Profile
                    </h2>

                    <p class="text-xs text-slate-500 mt-1">
                        Customize your profile
                    </p>
                </div>

                <button onclick="closeProfileModal()"
                        class="w-10 h-10 rounded-full bg-rose-500/10 hover:bg-rose-500/20 flex items-center justify-center">

                    <i class="fa-solid fa-xmark text-rose-400"></i>

                </button>

            </div>

            <div class="p-6 space-y-6">

                <div class="flex flex-col items-center gap-4">

                    <img id="main-profile-preview"
                         src="https://ui-avatars.com/api/?name=@userName&background=7c3aed&color=fff"
                         class="w-32 h-32 rounded-full object-cover border-4 border-purple-500/30" />

                    <input type="file"
                           accept="image/*"
                           onchange="previewProfile(event)"
                           class="text-xs text-slate-400" />

                </div>

                <!-- USERNAME -->

                <div>

                    <label class="text-xs uppercase tracking-widest text-slate-500">
                        Username
                    </label>

                    <input type="text"
                           id="username-input"
                           value="@userName"
                           class="w-full mt-2 bg-slate-900 border border-slate-800 rounded-xl px-4 py-3 text-sm outline-none focus:border-purple-500" />

                </div>

                <!-- BIO -->

                <div>

                    <label class="text-xs uppercase tracking-widest text-slate-500">
                        Bio
                    </label>

                    <textarea id="bio-input"
                              rows="3"
                              class="w-full mt-2 bg-slate-900 border border-slate-800 rounded-xl px-4 py-3 text-sm outline-none focus:border-purple-500"></textarea>

                </div>

                <!-- INTERESTS -->

                <div>

                    <label class="text-xs uppercase tracking-widest text-slate-500">
                        Interests
                    </label>

                    <input type="text"
                           id="interest-input"
                           class="w-full mt-2 bg-slate-900 border border-slate-800 rounded-xl px-4 py-3 text-sm outline-none focus:border-purple-500" />

                </div>

                <button onclick="saveProfile()"
                        class="w-full bg-purple-600 hover:bg-purple-500 py-3 rounded-xl uppercase tracking-widest text-sm font-bold">

                    Save Profile

                </button>

            </div>

        </div>

    </div>

    <script>

        // =========================
        // CURRENT USER KEY
        // =========================

        const currentUser =
        "@userName".replace(/\s+/g, "_").toLowerCase();

        function getUserStorageKey(key) {

        return `${currentUser}_${key}`;
        }

        // =========================
        // TOAST
        // =========================

        function toast(message) {

        const container =
        document.getElementById('toast-container');

        const toast =
        document.createElement('div');

        toast.className =
        'bg-slate-900 border border-purple-500/40 text-white px-5 py-4 rounded-2xl shadow-2xl text-xs uppercase tracking-widest';

        toast.innerText = message;

        container.appendChild(toast);

        setTimeout(() => {

        toast.remove();

        }, 3000);
        }

        // =========================
        // NOTIFICATIONS
        // =========================

        function toggleNotifications() {

        document
        .getElementById('notification-panel')
        .classList.toggle('hidden');
        }

        // =========================
        // MOVIE TRAILERS
        // =========================

        const movieTrailers = {

        "Avengers":
        "https://www.youtube.com/embed/eOrNdBpGMv8?autoplay=1",

        "Interstellar":
        "https://www.youtube.com/embed/zSWdZVtXT7E?autoplay=1",

        "Batman":
        "https://www.youtube.com/embed/mqqft2x_Aa4?autoplay=1",

        "Joker":
        "https://www.youtube.com/embed/zAGVQLHvwOY?autoplay=1",

        "John Wick":
        "https://www.youtube.com/embed/2AUmvWm5ZDQ?autoplay=1",

        "Spider":
        "https://www.youtube.com/embed/JfVOs4VSpmA?autoplay=1",

        "Titanic":
        "https://www.youtube.com/embed/kVrqfYjkTdQ?autoplay=1",

        "Conjuring":
        "https://www.youtube.com/embed/k10ETZ41q5o?autoplay=1",

        "Maleficent":
        "https://www.youtube.com/embed/w-XO4XiRop0?autoplay=1",

        "Fast":
        "https://www.youtube.com/embed/FUK2kdPsBws?autoplay=1",

        "Alita":
        "https://www.youtube.com/embed/w7pYhpJaJW8?autoplay=1"
        };

        // =========================
        // PLAY MOVIE
        // =========================

        function playMovieInline(title) {

        let selectedUrl =
        "https://www.youtube.com/embed/dQw4w9WgXcQ?autoplay=1";

        for (const key in movieTrailers) {

        if (title.toLowerCase().includes(key.toLowerCase())) {

        selectedUrl = movieTrailers[key];
        break;
        }
        }

        document.getElementById('modal-title').innerText =
        title.toUpperCase();

        document.getElementById('movie-frame').src =
        selectedUrl;

        document.getElementById('video-modal')
        .classList.remove('hidden');

        document.getElementById('video-modal')
        .classList.add('flex');

        document.body.style.overflow = "hidden";

        loadComments(title);
        }

        function closeMovieModal() {

        document.getElementById('video-modal')
        .classList.remove('flex');

        document.getElementById('video-modal')
        .classList.add('hidden');

        document.getElementById('movie-frame').src = "";

        document.body.style.overflow = "auto";
        }

        // =========================
        // PROFILE MODAL
        // =========================

        function openProfileModal() {

        document.getElementById('profile-modal')
        .classList.remove('hidden');

        document.getElementById('profile-modal')
        .classList.add('flex');

        document.body.style.overflow = "hidden";

        document.getElementById('bio-input').value =
        localStorage.getItem(getUserStorageKey('bio')) || '';

        document.getElementById('interest-input').value =
        localStorage.getItem(getUserStorageKey('interests')) || '';

        document.getElementById('username-input').value =
        localStorage.getItem(getUserStorageKey('username')) || '@userName';
        }

        function closeProfileModal() {

        document.getElementById('profile-modal')
        .classList.remove('flex');

        document.getElementById('profile-modal')
        .classList.add('hidden');

        document.body.style.overflow = "auto";
        }

        // =========================
        // PROFILE IMAGE
        // =========================

        function previewProfile(event) {

        const reader = new FileReader();

        reader.onload = function () {

        document.getElementById('profile-preview').src =
        reader.result;

        document.getElementById('main-profile-preview').src =
        reader.result;

        localStorage.setItem(
        getUserStorageKey('profile-image'),
        reader.result
        );
        };

        reader.readAsDataURL(event.target.files[0]);
        }

        // =========================
        // SAVE PROFILE
        // =========================

        function saveProfile() {

        const username =
        document.getElementById('username-input').value;

        const bio =
        document.getElementById('bio-input').value;

        const interests =
        document.getElementById('interest-input').value;

        localStorage.setItem(
        getUserStorageKey('username'),
        username
        );

        localStorage.setItem(
        getUserStorageKey('bio'),
        bio
        );

        localStorage.setItem(
        getUserStorageKey('interests'),
        interests
        );

        document.getElementById('username-display').innerText =
        username;

        toast("PROFILE SAVED SUCCESSFULLY");
        }

        // =========================
        // LOAD PROFILE
        // =========================

        window.addEventListener('load', () => {

        const image =
        localStorage.getItem(
        getUserStorageKey('profile-image')
        );

        const username =
        localStorage.getItem(
        getUserStorageKey('username')
        );

        if (image) {

        document.getElementById('profile-preview').src =
        image;

        document.getElementById('main-profile-preview').src =
        image;
        }

        if (username) {

        document.getElementById('username-display').innerText =
        username;
        }
        });

        // =========================
        // COMMENTS
        // =========================

        let currentMovie = "";

        function submitComment() {

        const input =
        document.getElementById('comment-input');

        const text =
        input.value.trim();

        if (!text) return;

        let allComments =
        JSON.parse(
        localStorage.getItem(
        getUserStorageKey('movie-comments')
        ) || '{}');

        if (!allComments[currentMovie]) {

        allComments[currentMovie] = [];
        }

        allComments[currentMovie].push({

        user:
        localStorage.getItem(
        getUserStorageKey('username')
        ) || "@userName",

        text: text
        });

        localStorage.setItem(
        getUserStorageKey('movie-comments'),
        JSON.stringify(allComments)
        );

        input.value = '';

        loadComments(currentMovie);
        }

        function loadComments(movieTitle) {

        currentMovie = movieTitle;

        const container =
        document.getElementById('comments-container');

        container.innerHTML = '';

        let allComments =
        JSON.parse(
        localStorage.getItem(
        getUserStorageKey('movie-comments')
        ) || '{}');

        let comments =
        allComments[movieTitle] || [];

        comments.forEach(comment => {

        container.innerHTML += `

        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4">

        <div class="flex items-center gap-2 mb-2">

        <div class="w-8 h-8 rounded-full bg-purple-600 flex items-center justify-center text-xs font-bold">
        ${comment.user.charAt(0).toUpperCase()}
        </div>

        <span class="text-xs uppercase tracking-widest text-purple-400 font-bold">
        ${comment.user}
        </span>

        </div>

        <p class="text-xs text-slate-300 leading-relaxed">
        ${comment.text}
        </p>

        </div>
        `;
        });

        container.scrollTop =
        container.scrollHeight;
        }

        // =========================
        // SAVE FAVORITES / DOWNLOADS
        // =========================

        function savePermanent(title, category) {

        let data =
        JSON.parse(
        localStorage.getItem(
        getUserStorageKey(category)
        ) || '[]'
        );

        if (!data.includes(title)) {

        data.push(title);

        localStorage.setItem(
        getUserStorageKey(category),
        JSON.stringify(data)
        );

        toast(`${title} saved in ${category}`);
        }
        else {

        toast(`${title} already exists`);
        }
        }

        // =========================
        // SWITCH TABS
        // =========================

        function switchTab(type, button) {

        document.querySelectorAll('.tab-btn')
        .forEach(btn =>
        btn.classList.remove('tab-active'));

        button.classList.add('tab-active');

        const cards =
        document.querySelectorAll('.movie-card');

        cards.forEach(card => {

        const title =
        card.getAttribute('data-title');

        if (type === 'all') {

        card.style.display = 'flex';
        return;
        }

        const items =
        JSON.parse(
        localStorage.getItem(
        getUserStorageKey(type)
        ) || '[]'
        );

        if (items.includes(title)) {

        card.style.display = 'flex';

        } else {

        card.style.display = 'none';
        }
        });
        }

    </script>

</body>
</html>