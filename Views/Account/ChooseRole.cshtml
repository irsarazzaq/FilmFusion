@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-900">
<head>
    <meta charset="utf-8" />
    <title>Select Operations Identity</title>
    <script src="https://unpkg.com/@@tailwindcss/browser@@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        .role-backdrop {
        background-image: linear-gradient(to bottom, rgba(15, 23, 42, 0.85), rgba(15, 23, 42, 0.85)), url('https://images.unsplash.com/photo-1517604931442-7e0c8ed2963c?q=80&w=1920&auto=format&fit=crop');
        background-size: cover;
        background-position: center;
        }
    </style>
</head>
<body class="h-full role-backdrop text-slate-200 flex items-center justify-center p-6">

    <div class="max-w-3xl w-full grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <a href="@Url.Action("Login", "Account")" class="group relative rounded-2xl p-6 bg-slate-800/80 border border-slate-700/50 hover:border-indigo-500 hover:bg-slate-800 transition-all shadow-xl flex flex-col justify-between min-h-[260px] backdrop-blur-sm">
            <div>
                <div class="w-12 h-12 bg-indigo-500/20 rounded-xl flex items-center justify-center text-indigo-400 text-xl group-hover:bg-indigo-500 group-hover:text-white transition-all mb-4">
                    <i class="fa-solid fa-user-shield"></i>
                </div>
                <h2 class="text-xl font-bold text-white tracking-tight">System Administrator</h2>
                <p class="text-xs text-slate-300 mt-2 leading-relaxed">Manage system databases, customize metadata structures, and access core operational master logs.</p>
            </div>
            <span class="text-xs font-semibold text-indigo-400 inline-flex items-center gap-1.5 mt-4">
                Access Admin Node <i class="fa-solid fa-chevron-right text-[10px]"></i>
            </span>
        </a>

        <a href="@Url.Action("Register", "Account")" class="group relative rounded-2xl p-6 bg-slate-800/80 border border-slate-700/50 hover:border-purple-500 hover:bg-slate-800 transition-all shadow-xl flex flex-col justify-between min-h-[260px] backdrop-blur-sm">
            <div>
                <div class="w-12 h-12 bg-purple-500/20 rounded-xl flex items-center justify-center text-purple-400 text-xl group-hover:bg-purple-500 group-hover:text-white transition-all mb-4">
                    <i class="fa-solid fa-users"></i>
                </div>
                <h2 class="text-xl font-bold text-white tracking-tight">Standard Member</h2>
                <p class="text-xs text-slate-300 mt-2 leading-relaxed">Personalize watch preferences, execute system search queries, and calibrate suggestions engine.</p>
            </div>
            <span class="text-xs font-semibold text-purple-400 inline-flex items-center gap-1.5 mt-4">
                Launch Portal Engine <i class="fa-solid fa-chevron-right text-[10px]"></i>
            </span>
        </a>

    </div>

</body>
</html>