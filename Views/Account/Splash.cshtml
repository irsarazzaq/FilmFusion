@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950">
<head>
    <meta charset="utf-8" />
    <title>FilmFusion - Welcome</title>
    <script src="https://unpkg.com/@@tailwindcss/browser@@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    
    <style>
        /* Immersive Cinematic Custom Animations */
        @@keyframes slow-glow {
            0%, 100% { text-shadow: 0 0 10px rgba(129, 140, 248, 0.3), 0 0 20px rgba(129, 140, 248, 0.2); }
            50% { text-shadow: 0 0 25px rgba(168, 85, 247, 0.6), 0 0 40px rgba(129, 140, 248, 0.4); }
        }

        @@keyframes float {
            0%, 100% { transform: translateY(0px) scale(1); }
            50% { transform: translateY(-8px) scale(1.02); }
        }

        @@keyframes cinematic-reveal {
            0% { opacity: 0; transform: translateY(15px) scale(0.95); filter: blur(5px); }
            100% { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }
        }

        @@keyframes pulse-spotlight {
            0%, 100% { opacity: 0.2; transform: scale(1); }
            50% { opacity: 0.35; transform: scale(1.15); }
        }

        /* Utility Classes Link to Engine */
        .animate-cinema-glow { animation: slow-glow 4s ease-in-out infinite; }
        .animate-float { animation: float 5s ease-in-out infinite; }
        .animate-reveal { animation: cinematic-reveal 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
        .animate-spotlight { animation: pulse-spotlight 8s ease-in-out infinite; }
    </style>
</head>
<body class="h-full relative flex flex-col justify-between p-8 md:p-12 select-none text-slate-100 cursor-pointer overflow-hidden" onclick="goToChannels()">

    <div class="absolute inset-0 w-full h-full object-cover z-0 overflow-hidden pointer-events-none">
        <video autoplay loop muted playsinline class="w-full h-full object-cover scale-[1.05] transition-transform duration-1000">
            <source src="~/videos/bg-cinema2.mp4" type="video/mp4">
        </video>
        
        <div class="absolute inset-0 bg-radial from-purple-500/10 via-transparent to-transparent opacity-30 pointer-events-none z-10 animate-spotlight"></div>
        
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-slate-950/20 to-slate-950/30 z-10"></div>
    </div>

    <div class="flex items-center justify-between w-full relative z-20 transition-all duration-700">
        <div class="flex items-center gap-2 bg-slate-900/40 border border-slate-800/40 px-4 py-1.5 rounded-full backdrop-blur-md shadow-lg">
            <span class="w-2 h-2 rounded-full bg-indigo-400 animate-pulse"></span>
            <span class="text-[10px] font-mono tracking-widest text-slate-300 uppercase">System Active</span>
        </div>
        <div class="w-10 h-10 bg-slate-900/40 border border-slate-800/40 rounded-full flex items-center justify-center backdrop-blur-md">
            <i class="fa-solid fa-compact-disc text-indigo-400/80 text-lg [animation-duration:4s] animate-spin"></i>
        </div>
    </div>

    <div class="text-center max-w-2xl mx-auto relative z-20 bg-slate-950/20 p-10 md:p-12 rounded-[2rem] backdrop-blur-md border border-slate-700/20 shadow-[0_20px_50px_rgba(0,0,0,0.5)] animate-reveal">
        
        <div class="inline-flex items-center justify-center w-24 h-24 bg-gradient-to-br from-indigo-500 via-indigo-600 to-purple-600 rounded-3xl mb-6 shadow-2xl shadow-indigo-500/30 border border-indigo-400/20 animate-float">
            <i class="fa-solid fa-clapperboard text-white text-4xl"></i>
        </div>
        
        <h1 class="text-6xl md:text-7xl font-black tracking-tighter text-white uppercase select-none animate-cinema-glow filter drop-shadow-[0_5px_15px_rgba(0,0,0,0.8)]">
            FilmFusion
        </h1>
        
        <div class="w-24 h-1 bg-gradient-to-r from-indigo-500 to-purple-500 mx-auto my-5 rounded-full shadow-sm"></div>
        
        <p class="text-sm md:text-base text-slate-300 font-light tracking-wide max-w-md mx-auto leading-relaxed">
            Your centralized portal for intelligence analytics streaming dashboard management.
        </p>
    </div>

    <div class="text-center pb-4 relative z-20">
        <div class="inline-flex flex-col items-center gap-2">
            <p class="text-xs font-semibold tracking-[0.25em] text-indigo-400 uppercase animate-pulse">
                Click Anywhere To Continue
            </p>
            <div class="w-1 h-4 border-r-2 border-dashed border-indigo-500/50 animate-bounce mt-1"></div>
        </div>
    </div>

    <script>
        function goToChannels() {
            // Smoothly redirect to operational gateway controller nodes
            window.location.href = '@Url.Action("ChooseRole", "Account")';
        }
    </script>
</body>
</html>