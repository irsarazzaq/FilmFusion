@{
    Layout = "_AuthLayout";
}

<div class="max-w-md w-full bg-slate-900/40 backdrop-blur-xl border border-slate-800/60 rounded-3xl p-8 shadow-2xl space-y-6">
    <div class="text-center">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-indigo-600/20 text-indigo-400 mb-3 border border-indigo-500/30">
            <i class="fa-solid fa-user-plus text-xl"></i>
        </div>
        <h2 class="text-xl font-black uppercase tracking-wider text-white">Create Account</h2>
        <p class="text-xs text-slate-400 mt-1">Step 1 of 2: Security Credentials</p>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-3 bg-rose-500/10 border border-rose-500/30 text-rose-400 text-xs rounded-xl flex items-center gap-2">
            <i class="fa-solid fa-circle-exclamation"></i> @TempData["ErrorMessage"]
        </div>
    }

    <form asp-action="Register" method="post" class="space-y-4">
        <div>
            <label class="text-[10px] text-indigo-400 font-bold uppercase tracking-wider block mb-1">Email Endpoint</label>
            <input type="email" name="email" required placeholder="name@domain.com" class="w-full bg-slate-950/80 border border-slate-800 rounded-xl px-4 py-3 text-xs text-white placeholder-slate-600 focus:outline-none focus:border-indigo-500 transition-colors" />
        </div>
        <div>
            <label class="text-[10px] text-indigo-400 font-bold uppercase tracking-wider block mb-1">Cipher Password</label>
            <input type="password" name="password" required placeholder="••••••••" class="w-full bg-slate-950/80 border border-slate-800 rounded-xl px-4 py-3 text-xs text-white placeholder-slate-600 focus:outline-none focus:border-indigo-500 transition-colors" />
        </div>
        <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs py-3 rounded-xl transition-all shadow-lg shadow-indigo-600/20 cursor-pointer">
            Proceed to Profile Setup <i class="fa-solid fa-arrow-right ml-1"></i>
        </button>
    </form>
    <div class="text-center border-t border-slate-800/60 pt-4">
        <a asp-action="Login" class="text-xs text-slate-400 hover:text-indigo-400 transition-colors">Already have an account? Login here</a>
    </div>
</div>