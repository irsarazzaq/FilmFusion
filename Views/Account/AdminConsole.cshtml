@model IEnumerable<FilmFusion.Models.User>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Admin Operations Console</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-950 min-h-screen text-slate-100 p-8">
    <div class="max-w-6xl mx-auto space-y-6">
        <div class="flex justify-between items-center bg-slate-900 border border-slate-800 p-6 rounded-2xl">
            <div>
                <h1 class="text-xl font-black uppercase tracking-wider text-red-400"><i class="fa-solid fa-server"></i> Mainframe Telemetry Console</h1>
                <p class="text-xs text-slate-400 mt-1">Live indexing records pulled directly from PostgreSQL database pipeline cluster.</p>
            </div>
            <a href="@Url.Action("Logout", "Account")" class="bg-rose-600/20 text-rose-400 border border-rose-500/20 px-4 py-2 rounded-xl text-xs font-bold hover:bg-rose-600/30 transition-all">Logout Dashboard</a>
        </div>

        <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-xl">
            <table class="w-full text-left text-xs border-collapse">
                <thead>
                    <tr class="bg-slate-950 text-indigo-400 font-bold border-b border-slate-800 uppercase tracking-wider">
                        <th class="p-4">Full Identity Node Name</th>
                        <th class="p-4">Email Matrix Address</th>
                        <th class="p-4">Genre Vector</th>
                        <th class="p-4">Advanced Telemetry Profile (Metadata)</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-800/60">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var user in Model)
                        {
                            <tr class="hover:bg-slate-800/40 transition-colors">
                                <td class="p-4 font-bold text-white">@user.FullName</td>
                                <td class="p-4 text-slate-300 font-mono">@user.Email</td>
                                <td class="p-4"><span class="bg-indigo-500/10 border border-indigo-500/20 px-2 py-1 rounded-md text-indigo-300">@user.PreferredGenre</span></td>
                                <td class="p-4 text-slate-400 font-mono text-[11px]">@user.SystemInterests</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="4" class="p-8 text-center text-slate-500 font-mono">Zero dynamic user data blocks discovered in database layers.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>