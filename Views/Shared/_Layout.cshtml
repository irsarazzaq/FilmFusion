<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950 text-slate-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FilmFusion</title>
    <script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        .glass-panel {
        background: rgba(30, 41, 59, 0.4);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.05);
        }
        .glow-button {
        transition: all 0.3s ease;
        box-shadow: 0 0 0px rgba(99, 102, 241, 0);
        }
        .glow-button:hover {
        box-shadow: 0 0 20px rgba(99, 102, 241, 0.4);
        transform: translateY(-1px);
        }
    </style>
</head>
<body class="h-full font-sans antialiased flex overflow-hidden">

    <aside class="w-64 glass-panel h-full flex flex-col justify-between p-5 border-r border-slate-800">
        <div>
            <div class="flex items-center gap-3 px-2 py-4 mb-8">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-500 to-violet-500 flex items-center justify-center shadow-lg shadow-indigo-500/30">
                    <i class="fa-solid fa-clapperboard text-white text-xl animate-pulse"></i>
                </div>
                <div>
                    <h1 class="text-xl font-black bg-gradient-to-r from-indigo-400 to-violet-400 bg-clip-text text-transparent tracking-wider">FILMFUSION</h1>
                    <span class="text-xs text-slate-500 font-semibold uppercase tracking-widest">Next-Gen Portal</span>
                </div>
            </div>

            <nav class="space-y-1.5">
                <a asp-controller="Home" asp-action="Index" class="flex items-center gap-4 px-4 py-3 rounded-xl text-slate-300 hover:bg-slate-800/60 hover:text-white transition-all group font-medium">
                    <i class="fa-solid fa-chart-pie text-indigo-400 group-hover:scale-110 transition-transform"></i>
                    <span>Dashboard</span>
                </a>
                <a href="#" class="flex items-center gap-4 px-4 py-3 rounded-xl text-slate-400 hover:bg-slate-800/60 hover:text-white transition-all group font-medium">
                    <i class="fa-solid fa-film text-slate-400 group-hover:text-indigo-400 group-hover:scale-110 transition-transform"></i>
                    <span>Movie Engine</span>
                </a>
                <a href="#" class="flex items-center gap-4 px-4 py-3 rounded-xl text-slate-400 hover:bg-slate-800/60 hover:text-white transition-all group font-medium">
                    <i class="fa-solid fa-robot text-slate-400 group-hover:text-indigo-400 group-hover:scale-110 transition-transform"></i>
                    <span>AI Assistant</span>
                </a>
                <a href="#" class="flex items-center gap-4 px-4 py-3 rounded-xl text-slate-400 hover:bg-slate-800/60 hover:text-white transition-all group font-medium">
                    <i class="fa-solid fa-users text-slate-400 group-hover:text-indigo-400 group-hover:scale-110 transition-transform"></i>
                    <span>Users Control</span>
                </a>
            </nav>
        </div>

        <div class="glass-panel p-3 rounded-xl flex items-center gap-3 bg-slate-900/40">
            <div class="w-10 h-10 rounded-lg bg-indigo-600/20 border border-indigo-500/30 flex items-center justify-center text-indigo-400 font-bold shadow-inner">
                VS
            </div>
            <div class="overflow-hidden">
                <p class="text-sm font-semibold text-slate-200 truncate">Administrator</p>
                <p class="text-xs text-indigo-400 font-medium truncate">Control Terminal</p>
            </div>
        </div>
    </aside>

    <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
        <header class="h-16 border-b border-slate-900 flex items-center justify-between px-8 bg-slate-950/80 backdrop-blur-md z-10">
            <div class="flex items-center gap-2">
                <span class="h-2 w-2 rounded-full bg-emerald-500 shadow-lg shadow-emerald-500/50"></span>
                <span class="text-xs font-semibold uppercase tracking-widest text-slate-400">Core Network Status: Connected</span>
            </div>
            <div class="flex items-center gap-4">
                <button class="relative p-2 text-slate-400 hover:text-white transition-colors">
                    <i class="fa-regular fa-bell text-lg"></i>
                    <span class="absolute top-1.5 right-1.5 h-1.5 w-1.5 bg-indigo-500 rounded-full"></span>
                </button>
            </div>
        </header>

        <main class="flex-1 overflow-y-auto p-8 bg-gradient-to-b from-slate-950 to-slate-900">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>