<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FilmFusion Enterprise</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen font-sans flex flex-col md:flex-row">

    <aside class="w-full md:w-64 bg-slate-900 border-b md:border-b-0 md:border-r border-slate-800 flex flex-col flex-shrink-0">
        <div class="p-5 border-b border-slate-800/60 flex items-center gap-3">
            <div class="w-8 h-8 bg-indigo-600 rounded-xl flex items-center justify-center shadow-lg shadow-indigo-500/20">
                <i class="fa-solid fa-fusion-core text-white text-sm animate-spin-slow"></i>
            </div>
            <div>
                <h2 class="text-sm font-black font-mono tracking-wider text-white uppercase">FILMFUSION</h2>
                <p class="text-[9px] text-slate-500 font-mono">Enterprise Control System</p>
            </div>
        </div>

        <nav class="p-4 flex-grow space-y-1.5">
            <a asp-controller="Home" asp-action="Index" class="flex items-center gap-3 px-4 py-3 text-slate-400 hover:text-white hover:bg-slate-950 rounded-xl font-mono text-xs font-bold tracking-wide transition-all duration-200 group">
                <i class="fa-solid fa-terminal text-indigo-400 group-hover:scale-110 transition-transform"></i>
                <span>Cluster Dashboard</span>
            </a>

            <a asp-controller="Home" asp-action="UsersControl" class="flex items-center gap-3 px-4 py-3 text-slate-400 hover:text-white hover:bg-slate-950 rounded-xl font-mono text-xs font-bold tracking-wide transition-all duration-200 group">
                <i class="fa-solid fa-users-gear text-purple-400 group-hover:scale-110 transition-transform"></i>
                <span>Users Control Hub</span>
            </a>

            <hr class="border-slate-800/60 my-4" />

            <a asp-controller="Account" asp-action="Logout" class="flex items-center gap-3 px-4 py-3 text-rose-500/80 hover:text-rose-400 hover:bg-rose-950/20 rounded-xl font-mono text-xs font-bold tracking-wide transition-all duration-200 group">
                <i class="fa-solid fa-power-off group-hover:scale-110 transition-transform"></i>
                <span>Disconnect Node</span>
            </a>
        </nav>

        <div class="p-4 border-t border-slate-800/60 bg-slate-950/40 text-[9px] font-mono text-slate-500 space-y-0.5">
            <p>Database: PostgreSQL Matrix</p>
            <p>System Status: <span class="text-emerald-500 font-bold">Operational</span></p>
        </div>
    </aside>

    <main class="flex-grow overflow-x-hidden">
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>